# Copy to .env and fill in. Only GROQ_API_KEY is required for the spine.
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (defaults shown)
# GROQ_MODEL_LARGE=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# PORT=8100
# CORS_ORIGINS=["http://localhost:5173"]

# Phase 3 (HITL): switch to postgres and set the DSN
# CHECKPOINTER=postgres
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/agent
