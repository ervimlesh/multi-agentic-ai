# Copy to .env and adjust for your environment.
PROJECT_NAME="Multi-Agent AI Platform"
DEBUG=true

# SQLite (default, zero-setup). For Postgres use:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/multi_agentic_ai
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-super-secret-key-for-dev-only-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== GROQ (FREE LLM - 100% Free tier) =====
# Get free key: https://console.groq.com → Sign in with Google → API Keys → Create
GROQ_API_KEY=gsk_your_key_here


# --- OTP (passwordless auth) ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMTP (required to actually deliver codes; otherwise codes are logged) ---
# Example for Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Multi-Agent AI <no-reply@example.com>"
SMTP_STARTTLS=true
