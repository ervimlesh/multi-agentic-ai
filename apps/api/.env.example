# Copy to .env and adjust for your environment.
PROJECT_NAME="Multi-Agent AI Platform"
DEBUG=true

# SQLite (default, zero-setup). For Postgres use:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/multi_agentic_ai
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-super-secret-key-for-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BCRYPT_ROUNDS=12
