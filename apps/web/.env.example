# Base URL of the API service. Leave empty to use Vite's dev proxy (recommended
# for local dev — see vite.config.ts). For a deployed backend set e.g.:
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Base URL of the agent-engine (LangGraph + Groq) service. Leave empty to use
# Vite's dev proxy (/agent -> http://localhost:8100). For a deployed engine:
# VITE_AGENT_URL=https://agent.example.com
VITE_AGENT_URL=
