{
  "info": {
    "name": "Multi-Agentic AI — Auth (Passwordless OTP)",
    "_postman_id": "a1b2c3d4-0002-4000-8000-otp00collec01",
    "description": "Passwordless email-OTP auth flow for the Multi-Agent AI Platform API.\n\nFlow:\n1. Register (sign up)  OR  Login (sign in) -> server emails a 6-digit code.\n2. Verify the code -> receive user + access/refresh tokens.\n\nSet the {{otp_code}} collection variable to the code from your email before running Verify. Tokens are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "email", "value": "alice@example.com", "type": "string" },
    { "key": "full_name", "value": "Alice Tester", "type": "string" },
    { "key": "otp_code", "value": "", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Register (request OTP)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"full_name\": \"{{full_name}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('otp sent', () => pm.expect(pm.response.json().message).to.include('code'));",
              "console.log('Check your inbox, then set {{otp_code}} and run Verify.');"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Login (request OTP)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Verify OTP -> tokens",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otp_code}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "verify"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('returns tokens', () => pm.expect(b.tokens.access_token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('access_token', b.tokens.access_token);",
              "pm.collectionVariables.set('refresh_token', b.tokens.refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Resend OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/resend",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "resend"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Get Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/me",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('email matches', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/refresh",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "refresh"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.collectionVariables.set('access_token', b.access_token);",
              "pm.collectionVariables.set('refresh_token', b.refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "logout"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    }
  ]
}
