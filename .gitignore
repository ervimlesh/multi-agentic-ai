# ===========================================================================
# Multi-AI-Agent Platform — .gitignore
# Covers: Node/TypeScript, Python, Docker, Terraform, Kubernetes, IDEs, OS
# ===========================================================================

# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.crt
secrets/
**/secrets/*
!**/secrets/.gitkeep
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Node / TypeScript / Frontend (apps/web, packages/*)
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.vite/
.turbo/
.cache/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Package manager logs/locks (keep lockfiles tracked — comment out if undesired)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------------------------------------------------------------------------
# Python (apps/api, apps/agent-engine, apps/workers/*)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.installed.cfg

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Terraform (infra/terraform)
# ---------------------------------------------------------------------------
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------------------
# Docker / Kubernetes
# ---------------------------------------------------------------------------
*.env.docker
docker-compose.override.local.yml
kubeconfig
*.kubeconfig

# ---------------------------------------------------------------------------
# Databases / data / uploads
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
data/
uploads/
tmp/
temp/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# IDE / Editor
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.bak
*.tmp
.history/
